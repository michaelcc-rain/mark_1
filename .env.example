# Rain sandbox API key (server-side secret — never prefix with NEXT_PUBLIC_).
# Get it from the Rain Dashboard → Config (https://www.use-dev.raincards.xyz).
RAIN_API_KEY=

# Optional: pin a specific card instead of the httpOnly cookie (e.g. skip issue-card).
RAIN_CARD_ID=

# Which Rain issuing API to use: "dev" (sandbox, default) or "production".
# Must match the RAIN_API_KEY: keys are per environment. Leave unset for the sandbox demo.
RAIN_ENVIRONMENT=dev
